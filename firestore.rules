rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todos pueden LEER el menú (comensales).
    // Solo el administrador (ale@muelle871.com) puede ESCRIBIR.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "ale@muelle871.com";
    }
  }
}
